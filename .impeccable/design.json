   "description": "What's on a deck: letter tile, title, readout, progress.",
   "html": "<div class=\"ds-deck\"><span class=\"ds-tag\">A</span><div><div class=\"ds-title\">Tavern at Dusk</div><div class=\"ds-status\">1:24 / 3:02</div><div class=\"ds-bar\"><i></i></div></div></div>",
   "css": ".ds-deck{display:grid;grid-template-columns:26px 1fr;gap:8px;align-items:center;padding:8px;border-radius:8px;background:#272830;color:#e8e6e3;width:260px}.ds-tag{width:26px;height:26px;border-radius:5px;display:grid;place-items:center;font-weight:800;font-size:14px;background:#6fb1e8;color:#111318}.ds-title{font-weight:600;font-size:14px}.ds-status{font-size:13px;font-weight:500;color:#c4c2cc;font-variant-numeric:tabular-nums}.ds-bar{height:3px;background:#3a3b46;border-radius:2px;margin-top:4px}.ds-bar i{display:block;height:100%;width:45%;background:#6fb1e8}"
  },
