   "refersTo": "button-fade",
   "description": "The crossfade action.",
   "html": "<button class=\"ds-fade\">⇄ Fade</button>",
   "css": ".ds-fade{background:#e0a65a;color:#111318;border:none;border-radius:6px;font-weight:700;font-size:11px;padding:4px 10px;cursor:pointer}.ds-fade:hover{filter:brightness(1.1)}.ds-fade:focus-visible{outline:2px solid #e0a65a;outline-offset:2px}"
  },
