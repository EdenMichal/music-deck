{{#*inline "deck"}}
<div class="md-deck {{css}} {{#if playing}}playing{{/if}} {{#unless audible}}off-air{{/unless}}" data-deck="{{id}}" data-state="{{state}}" {{#if soundId}}data-sound-id="{{soundId}}"{{/if}}>
  <span class="md-tag" aria-label="{{label}}">{{tag}}</span>
  <div class="md-info">
    <div class="md-title-line">
      <span class="md-title" data-tooltip="{{title}}">{{title}}</span>
      <span class="md-air" data-tooltip="The players hear this deck">On air</span>
    </div>
    <div class="md-readout"><i class="md-state fa-solid {{stateIcon}}" aria-hidden="true"></i><span class="md-status">{{status}}</span></div>
    <div class="md-bar"><i style="width: {{progress}}%"></i></div>
  </div>
  <div class="md-ctrls">
    <button type="button" class="md-icon" data-action="mdDeckPlay" {{#unless hasTrack}}disabled{{/unless}}
      data-tooltip="{{playTip}}" aria-label="{{playTip}}">
      <i class="fa-solid {{#if playing}}fa-pause{{else}}fa-play{{/if}}"></i>
    </button>
    <button type="button" class="md-icon" data-action="mdDeckNext" data-tooltip="Next track" aria-label="Next track on {{label}}" {{#unless count}}disabled{{/unless}}>
      <i class="fa-solid fa-forward-step"></i>
    </button>
  </div>
  {{#if cues}}
    <div class="md-cues" role="group" aria-label="Cues on {{label}}">
      {{#each cues}}<button type="button" class="md-cue {{#if lit}}lit{{/if}} {{#if pending}}pending{{/if}} {{#if once}}once{{/if}}" style="--cue: {{color}}"
        data-action="mdGoCue" data-cue="{{id}}" data-tooltip="{{tip}}" aria-label="{{tip}}" aria-pressed="{{#if lit}}true{{else}}false{{/if}}"><span class="md-cue-n">{{n}}</span><span class="md-cue-name">{{name}}</span></button>{{/each}}
      {{#if phase}}<button type="button" class="md-cue md-phase" data-action="mdNextPhase" {{#unless phase.next}}disabled{{/unless}}
        data-tooltip="{{phase.tip}}" aria-label="{{phase.tip}}"><i class="fa-solid fa-forward" aria-hidden="true"></i><span class="md-cue-name">Next phase</span></button>{{/if}}
      <button type="button" class="md-icon md-cue-edit" data-action="mdEditCues" data-tooltip="Edit cues" aria-label="Edit this track's cues"><i class="fa-solid fa-scissors"></i></button>
    </div>
  {{/if}}
</div>
{{/inline}}
<section class="md-now mode-{{mode.id}} {{#if panic}}is-panic{{/if}}">
  <div class="md-status-line">
    <button type="button" class="md-playmode {{mode.id}}" data-action="mdPlayMode" data-mode="{{mode.next}}"
      data-tooltip="{{mode.tip}}" aria-label="{{mode.tip}}"><i class="fa-solid {{mode.icon}}"></i> {{mode.label}}</button>
    <button type="button" class="md-panic {{#if panic}}on{{/if}}" data-action="mdPanic"
      data-tooltip="Fade every Music Deck sound to silence for everyone. Press again to bring it back.">
      <i class="fa-solid fa-power-off"></i> <span class="md-panic-label">{{#if panic}}Bring back{{else}}Fade all{{/if}}</span>
    </button>
  </div>
  <p class="md-panic-note" role="status" {{#unless panic}}hidden{{/unless}}>
    <i class="fa-solid fa-volume-off" aria-hidden="true"></i> Everything is faded out. The table hears nothing.
  </p>
  <div class="md-presence">
    <span class="md-dot {{hear}}" aria-hidden="true"></span><span class="md-presence-text">{{status}}</span>
    {{#if cantHear}}<span class="md-hear-warn" role="status" data-tooltip="{{cantHear.tip}}">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{cantHear.label}}
    </span>{{/if}}
    {{#if link}}<button type="button" class="md-link-chip {{link.css}}" data-action="mdPairDeck" data-tooltip="{{link.tip}}" aria-label="{{link.tip}}">
      <i class="fa-solid fa-sliders"></i>{{#if link.label}} {{link.label}}{{/if}}
    </button>{{/if}}
  </div>
  {{#if cantHear}}<p class="md-hear-who">{{cantHear.who}}</p>{{/if}}

  <section class="md-fold-sec {{#if fold.volumes}}is-folded{{/if}}" data-fold-sec="volumes">
    <button type="button" class="md-fold" data-action="mdFold" data-fold="volumes" aria-expanded="{{#if fold.volumes}}false{{else}}true{{/if}}">
      <i class="fa-solid fa-chevron-down md-fold-icon" aria-hidden="true"></i><span class="md-fold-title">Volumes</span>
      <span class="md-fold-sum" data-sum="volumes" data-tooltip="{{volumesSummary}}">{{volumesSummary}}</span>
    </button>
    <div class="md-fold-body">
      <div class="md-levels">
        <div class="md-level md-level-music {{#if muted}}is-muted{{/if}}">
          <span class="md-level-name"><i class="fa-solid fa-music"></i> Music</span>
          <input type="range" min="0" max="100" value="{{musicVol}}" data-slider="musicVol" aria-label="Music volume">
          <span class="md-pct" data-label="musicVol">{{musicVol}}%</span>
          <button type="button" class="md-icon md-mute {{#if muted}}on{{/if}}" data-action="mdMute" data-tooltip="Mute music" aria-label="Mute music" aria-pressed="{{#if muted}}true{{else}}false{{/if}}">
            <i class="fa-solid fa-volume-high md-mute-off" aria-hidden="true"></i><i class="fa-solid fa-volume-xmark md-mute-on" aria-hidden="true"></i>
          </button>
        </div>
        <div class="md-level md-level-amb {{#if ambient.muted}}is-muted{{/if}}">
          <span class="md-level-name"><i class="fa-solid fa-cloud-rain"></i> Ambient</span>
          <input type="range" min="0" max="100" value="{{ambient.vol}}" data-slider="ambientVol" aria-label="Ambient volume">
          <span class="md-pct" data-label="ambientVol">{{ambient.vol}}%</span>
          <button type="button" class="md-icon md-mute {{#if ambient.muted}}on{{/if}}" data-action="mdAmbMute" data-tooltip="Mute ambient" aria-label="Mute ambient" aria-pressed="{{#if ambient.muted}}true{{else}}false{{/if}}">
            <i class="fa-solid fa-volume-high md-mute-off" aria-hidden="true"></i><i class="fa-solid fa-volume-xmark md-mute-on" aria-hidden="true"></i>
          </button>
        </div>
        <div class="md-level md-level-sfx {{#if sfx.muted}}is-muted{{/if}}">
          <span class="md-level-name"><i class="fa-solid fa-bell"></i> SFX</span>
          <input type="range" min="0" max="100" value="{{sfx.vol}}" data-slider="sfxVol" aria-label="SFX volume">
          <span class="md-pct" data-label="sfxVol">{{sfx.vol}}%</span>
          <button type="button" class="md-icon md-mute {{#if sfx.muted}}on{{/if}}" data-action="mdSfxMute" data-tooltip="Mute SFX" aria-label="Mute SFX" aria-pressed="{{#if sfx.muted}}true{{else}}false{{/if}}">
            <i class="fa-solid fa-volume-high md-mute-off" aria-hidden="true"></i><i class="fa-solid fa-volume-xmark md-mute-on" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div class="md-amb-line {{#if ambient.on}}on{{/if}}">
        <button type="button" class="md-icon" data-action="mdAmbToggle"
          data-tooltip="{{#if ambient.on}}Pause all layers{{else}}Play the layers that were on{{/if}}"
          aria-label="{{#if ambient.on}}Pause all layers{{else}}Play the layers that were on{{/if}}">
          <i class="fa-solid {{#if ambient.on}}fa-pause{{else}}fa-play{{/if}}"></i>
        </button>
        <i class="fa-solid fa-cloud-rain md-amb-icon" aria-hidden="true"></i>
        <span class="md-amb-names" data-tooltip="{{ambient.names}}">{{ambient.names}}</span>
      </div>
    </div>
  </section>
  <section class="md-fold-sec {{#if fold.decks}}is-folded{{/if}}" data-fold-sec="decks">
    <button type="button" class="md-fold" data-action="mdFold" data-fold="decks" aria-expanded="{{#if fold.decks}}false{{else}}true{{/if}}">
      <i class="fa-solid fa-chevron-down md-fold-icon" aria-hidden="true"></i><span class="md-fold-title">Decks</span>
      <span class="md-fold-sum" data-sum="decks" data-tooltip="{{decksSummary}}">{{decksSummary}}</span>
    </button>
    <div class="md-fold-body">
      {{> deck decks.[0]}}
      <div class="md-fader">
        <span class="md-key a" aria-hidden="true">A</span>
        <input type="range" min="0" max="100" value="{{fader}}" data-slider="fader" aria-label="Crossfader, A to B">
        <span class="md-key b" aria-hidden="true">B</span>
        <button type="button" class="md-fade-btn" data-action="mdFade" data-tooltip="Fade to the other deck over {{fadeSeconds}} s">
          <i class="fa-solid fa-right-left" aria-hidden="true"></i> Fade to <span class="md-fade-to">{{fadeTo}}</span>
        </button>
      </div>
      {{> deck decks.[1]}}
    </div>
  </section>
  {{#if battle}}
  <section class="md-fold-sec md-bdeck-sec {{#if fold.battle}}is-folded{{/if}} {{#if battle.on}}on{{/if}}" data-fold-sec="battle">
    <button type="button" class="md-fold" data-action="mdFold" data-fold="battle" aria-expanded="{{#if fold.battle}}false{{else}}true{{/if}}">
      <i class="fa-solid fa-chevron-down md-fold-icon" aria-hidden="true"></i><span class="md-fold-title"><i class="fa-solid fa-khanda md-bdeck-icon" aria-hidden="true"></i> Battle deck</span>
      <span class="md-fold-sum" data-sum="battle" data-tooltip="{{battle.summary}}">{{battle.summary}}</span>
    </button>
    <div class="md-fold-body">
      <div class="md-bdeck" data-deck="battle">
        <div class="md-bdeck-head">
          <span class="md-bdeck-note">{{battle.note}}</span>
          {{#if battle.on}}
          <button type="button" class="md-chip md-bdeck-btn" data-action="mdBattleBack" data-tooltip="Fade back to decks A and B; they pick up where they paused">Back to A/B</button>
          {{else}}
          <button type="button" class="md-icon" data-action="mdBattleReload" data-tooltip="Shuffle the battle music onto the Battle deck afresh" aria-label="Reload the battle music"><i class="fa-solid fa-shuffle"></i></button>
          {{/if}}
        </div>
        {{> deck battle.card}}
        <div class="md-level md-level-battle {{#if muted}}is-muted{{/if}}">
          <span class="md-level-name"><i class="fa-solid fa-khanda"></i> Battle</span>
          <input type="range" min="0" max="100" value="{{battle.vol}}" data-slider="battleVol" aria-label="Battle deck volume">
          <span class="md-pct" data-label="battleVol">{{battle.vol}}%</span>
        </div>
        <ol class="md-bdeck-queue" data-deck="battle" aria-label="Battle deck queue">
          {{#each battle.rows}}
          <li class="md-row {{#if current}}current{{/if}} {{#if playing}}playing{{/if}}" data-sound-id="{{id}}">
            <span class="md-num">{{#if playing}}<i class="fa-solid fa-volume-high" aria-label="Playing"></i>{{else}}{{n}}{{/if}}</span>
            <span class="md-name">{{name}}</span>
            <span class="md-dur">{{duration}}</span>
            <span class="md-hover">
              <button type="button" class="md-chip" data-action="mdPlayNow">Play now</button>
              <button type="button" class="md-chip md-chip-x" data-action="mdEditCues" data-tooltip="Edit cues" aria-label="Edit cues of {{name}}"><i class="fa-solid fa-scissors"></i></button>
              <button type="button" class="md-chip md-chip-x" data-action="mdRemove" data-tooltip="Remove from the Battle deck" aria-label="Remove {{name}} from the Battle deck"><i class="fa-solid fa-xmark"></i></button>
            </span>
          </li>
          {{else}}
          <li class="md-empty">No battle music yet. ▶ loads it from your battle music (Library › right-click › Use for battle music).</li>
          {{/each}}
        </ol>
      </div>
    </div>
  </section>
  {{/if}}
</section>
